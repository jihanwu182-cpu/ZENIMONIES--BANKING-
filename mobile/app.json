
{
  "expo": {
    "name": "ZENIMONIES",
    "slug": "zenimonies-mobile",
    "version": "1.0.0",
    "scheme": "zenimonies",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zenimonies.mobile"
    },
    "android": {
      "package": "com.zenimonies.mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f5a1b03e-8b9b-48de-b2dd-caaf6df71051"
      }
    },
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
